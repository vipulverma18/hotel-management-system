generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@hotels/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomType {
  STANDARD
  DELUXE
  SUITES
}

model Room {
  id        Int      @id @default(autoincrement())
  number    Int
  type      RoomType
  price     Float
  aminities Json
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  hotelId   Int
}

model Hotel {
  id      Int    @id @default(autoincrement())
  rooms   Room[]
  street  String
  city    String
  pincode String
  state   String
}

model User {
  id   Int    @id @default(autoincrement())
  name String

  reservations Reservation[]
}

model Reservation {
  id         Int      @id @default(autoincrement())
  checkIn    DateTime
  checkOut   DateTime
  roomType   RoomType
  totalRooms Int
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
}
