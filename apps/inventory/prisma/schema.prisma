generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@inventory/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomType {
  STANDARD
  DELUXE
  SUITES
}

model Inventory {
  hotelId  Int
  roomType RoomType
  date     DateTime
  reserved Int
  total    Int

  @@id([hotelId, roomType, date])
}
